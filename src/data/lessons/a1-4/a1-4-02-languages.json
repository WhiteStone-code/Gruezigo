  "dialogueExample": [
    { "speaker": "🧑", "schwiizerduetsch": "Weli Sprache redsch du?", "base": { "es": "¿Qué idiomas hablas?", "en": "What languages do you speak?", "pt": "Que línguas falas?", "fr": "Quelles langues parles-tu ?", "it": "Che lingue parli?", "sq": "Cilat gjuhë flet?", "tr": "Hangi dilleri konuşuyorsun?" } },
