    { "speaker": "🧑", "schwiizerduetsch": "Und Schwiizerdütsch — lehrsch das grad?", "base": { "es": "¿Y suizo-alemán — lo estás aprendiendo ahora?", "en": "And Swiss German — are you learning it now?", "pt": "E suíço-alemão — estás a aprendê-lo agora?", "fr": "Et le suisse-allemand — tu l'apprends en ce moment ?", "it": "E lo svizzero-tedesco — lo stai imparando ora?", "sq": "Po gjermanishten zvicerane — a po e mëson tani?", "tr": "Ya İsviçre Almancası — şu an mı öğreniyorsun?" } },
    { "speaker": "👨", "schwiizerduetsch": "Genau! Ich lehr's mit GrüeziGo.", "base": { "es": "¡Exacto! Lo estoy aprendiendo con GrüeziGo.", "en": "Exactly! I'm learning it with GrüeziGo.", "pt": "Exatamente! Estou a aprendê-lo com o GrüeziGo.", "fr": "Exactement ! Je l'apprends avec GrüeziGo.", "it": "Esatto! Lo sto imparando con GrüeziGo.", "sq": "Saktësisht! Po e mësoj me GrüeziGo.", "tr": "Aynen! GrüeziGo ile öğreniyorum." } }
  ],
