      "npcEmoji": "🚶",
      "turns": [
        { "speaker": "npc", "text": "Grüezi, chan ich Ihne hälfe?", "base": { "es": "Hola, ¿puedo ayudarle?", "en": "Hi, can I help you?", "pt": "Olá, posso ajudá-lo?", "fr": "Bonjour, je peux vous aider ?", "it": "Buongiorno, posso aiutarla?", "sq": "Përshëndetje, a mund t'ju ndihmoj?", "tr": "Merhaba, size yardımcı olabilir miyim?" } },
        {
          "speaker": "user",
          "options": [
            { "text": "Ja gern, ich sueche d'Apotheke.", "base": { "es": "Sí, por favor, busco la farmacia.", "en": "Yes please, I'm looking for the pharmacy.", "pt": "Sim, por favor, procuro a farmácia.", "fr": "Oui, s'il vous plaît, je cherche la pharmacie.", "it": "Sì, per favore, cerco la farmacia.", "sq": "Po ju lutem, po kërkoj farmacinë.", "tr": "Evet lütfen, eczane arıyorum." }, "correct": true },
            { "text": "Nei danke.", "base": { "es": "No, gracias.", "en": "No thanks.", "pt": "Não, obrigado.", "fr": "Non merci.", "it": "No grazie.", "sq": "Jo faleminderit.", "tr": "Hayır, teşekkürler." }, "correct": false, "feedback": { "es": "Si de verdad necesitas ayuda, mejor aceptarla — puedes usar la frase para pedir lo que buscas.", "en": "If you really need help, better to accept it — you can use the phrase to ask for what you're looking for.", "pt": "Se realmente precisas de ajuda, é melhor aceitá-la — podes usar a frase para pedir o que procuras.", "fr": "Si vous avez vraiment besoin d'aide, mieux vaut l'accepter — vous pouvez utiliser la phrase pour demander ce que vous cherchez.", "it": "Se hai davvero bisogno di aiuto, meglio accettarlo — puoi usare la frase per chiedere ciò che cerchi.", "sq": "Nëse vërtet të duhet ndihmë, më mirë pranoje — mund ta përdorësh frazën për të kërkuar atë që kërkon.", "tr": "Gerçekten yardıma ihtiyacın varsa, kabul etmek daha iyi — aradığını sormak için ifadeyi kullanabilirsin." } }
          ]
        },
        { "speaker": "npc", "text": "D'Apotheke isch dete äne, näb de Chile.", "base": { "es": "La farmacia está allí enfrente, junto a la iglesia.", "en": "The pharmacy is right over there, next to the church.", "pt": "A farmácia é ali em frente, ao lado da igreja.", "fr": "La pharmacie est juste là, à côté de l'église.", "it": "La farmacia è proprio lì di fronte, vicino alla chiesa.", "sq": "Farmacia është pikërisht atje, pranë kishës.", "tr": "Eczane tam karşıda, kilisenin yanında." } },
        {
          "speaker": "user",
          "options": [
            { "text": "Merci vilmal für Ihre Hilf!", "base": { "es": "¡Muchas gracias por su ayuda!", "en": "Thank you very much for your help!", "pt": "Muito obrigado pela sua ajuda!", "fr": "Merci beaucoup pour votre aide !", "it": "Grazie mille per il suo aiuto!", "sq": "Shumë faleminderit për ndihmën tuaj!", "tr": "Yardımınız için çok teşekkürler!" }, "correct": true },
            { "text": "Wie gaht's dir?", "base": { "es": "¿Cómo estás?", "en": "How are you?", "pt": "Como estás?", "fr": "Comment ça va ?", "it": "Come stai?", "sq": "Si je?", "tr": "Nasılsın?" }, "correct": false, "feedback": { "es": "No hace falta cambiar de tema — un simple agradecimiento cierra bien la conversación.", "en": "No need to change the subject — a simple thank-you closes the conversation nicely.", "pt": "Não precisas de mudar de assunto — um simples agradecimento fecha bem a conversa.", "fr": "Pas besoin de changer de sujet — un simple merci clôt bien la conversation.", "it": "Non serve cambiare argomento — un semplice ringraziamento chiude bene la conversazione.", "sq": "Nuk ka nevojë të ndryshosh temën — një falenderim i thjeshtë e mbyll bukur bisedën.", "tr": "Konuyu değiştirmeye gerek yok — basit bir teşekkür sohbeti güzelce bitirir." } }
          ]
        }
      ]
    }
