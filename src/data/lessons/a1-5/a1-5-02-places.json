      "scenario": { "es": "Preguntando por la farmacia en la calle", "en": "Asking about the pharmacy on the street", "pt": "A perguntar pela farmácia na rua", "fr": "Demander la pharmacie dans la rue", "it": "Chiedere della farmacia per strada", "sq": "Duke pyetur për farmacinë në rrugë", "tr": "Sokakta eczane sormak" },
