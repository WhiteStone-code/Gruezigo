  "grammarConcept": {
    "es": "Preguntar cómo llegar a un sitio y entender indicaciones básicas (izquierda, derecha, recto).",
    "en": "Asking how to get somewhere and understanding basic directions (left, right, straight ahead).",
    "pt": "Perguntar como chegar a um sítio e perceber indicações básicas (esquerda, direita, em frente).",
    "fr": "Demander comment se rendre quelque part et comprendre des indications de base (gauche, droite, tout droit).",
    "it": "Chiedere come arrivare in un posto e capire indicazioni di base (sinistra, destra, dritto).",
    "sq": "Të pyesësh si të shkosh diku dhe të kuptosh drejtime bazë (majtas, djathtas, drejt).",
    "tr": "Bir yere nasıl gidileceğini sormak ve temel yön tariflerini (sol, sağ, düz) anlamak."
  },
  "dialogueExample": [
    { "speaker": "🧑", "schwiizerduetsch": "Exgüsi, wie chumm ich zum Bahnhof?", "base": { "es": "Disculpe, ¿cómo llego a la estación?", "en": "Excuse me, how do I get to the station?", "pt": "Desculpe, como chego à estação?", "fr": "Excusez-moi, comment j'arrive à la gare ?", "it": "Mi scusi, come arrivo alla stazione?", "sq": "Më falni, si arrij te stacioni?", "tr": "Affedersiniz, istasyona nasıl giderim?" } },
    { "speaker": "🧑‍🦳", "schwiizerduetsch": "Gönd Sie grad us, dänn lingg.", "base": { "es": "Vaya recto, luego a la izquierda.", "en": "Go straight, then left.", "pt": "Vá em frente, depois à esquerda.", "fr": "Allez tout droit, puis à gauche.", "it": "Vada dritto, poi a sinistra.", "sq": "Ecni drejt, pastaj majtas.", "tr": "Düz gidin, sonra sola." } },
    { "speaker": "🧑", "schwiizerduetsch": "Isch das wiit vo da?", "base": { "es": "¿Está lejos de aquí?", "en": "Is it far from here?", "pt": "É longe daqui?", "fr": "C'est loin d'ici ?", "it": "È lontano da qui?", "sq": "A është larg nga këtu?", "tr": "Buradan uzak mı?" } },
    { "speaker": "🧑‍🦳", "schwiizerduetsch": "Nei, nume föif Minute z'Fuess.", "base": { "es": "No, solo cinco minutos a pie.", "en": "No, just five minutes on foot.", "pt": "Não, só cinco minutos a pé.", "fr": "Non, juste cinq minutes à pied.", "it": "No, solo cinque minuti a piedi.", "sq": "Jo, vetëm pesë minuta në këmbë.", "tr": "Hayır, sadece beş dakika yürüyerek." } }
